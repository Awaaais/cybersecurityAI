# TeKAI configuration — local-first, NO cloud API key required.
# Copy to .env.local and restart the dev server. Values below match YOUR
# machine: Ollama 0.35.1 + tinyllama:latest (637 MB) already installed.

# --- Default provider: Ollama (local, no API key) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=tinyllama:latest

# OLLAMA_MODEL must match `ollama list`. If you later upgrade to a stronger
# local model, just change it, e.g.:
#   ollama pull llama3.2   -> OLLAMA_MODEL=llama3.2
#   ollama pull qwen2.5:3b -> OLLAMA_MODEL=qwen2.5:3b
# See docs/tekai-ollama-setup.md for lightweight model guidance.

# --- Optional TeKAI performance tuning (sensible defaults, set only to override) ---
# Context window per request in tokens (clamped to 512-2048, default 2048).
# Lower it if RAM is very tight — but every change reloads the model, so pick
# one value and leave it alone.
# OLLAMA_NUM_CTX=2048
# How long Ollama keeps the model resident after an answer (default 30m).
# Shorten it to free RAM sooner, e.g. OLLAMA_KEEP_ALIVE=5m
# OLLAMA_KEEP_ALIVE=30m

